# Site Identity
SITE_NAME="Next Web Works"
NEXT_PUBLIC_SITE_URL="https://nextwebworks.in"

# NWW CMS Integration (Mode: Headless API)
SERVER_URL="https://prod-server.nextwebworks.com"
CMS_TOKEN="your-nww-cms-bearer-token"
REVALIDATE_SECRET="your-on-demand-isr-revalidation-secret"

# Analytics & Verification
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Pre-Launch Guard (true hides from search engines and displays staging badge)
NEXT_PUBLIC_PREVIEW_GUARD="true"

